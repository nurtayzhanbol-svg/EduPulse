# Port for the EduPulse server (default: 8000)
PORT=8000

# Comma-separated browser origins allowed to open a Socket.IO connection.
# Set this to the public URL of the deployed app (default: http://localhost:8000).
ALLOWED_ORIGINS=http://localhost:8000

# ── AI provider ───────────────────────────────────────────────────
# Azure OpenAI: set AZURE_OPENAI_API_KEY + AZURE_OPENAI_ENDPOINT,
# and set OPENAI_MODEL to your Azure *deployment* name.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# OpenAI (used when AZURE_OPENAI_ENDPOINT is empty)
OPENAI_API_KEY=

# Optional: OpenAI-compatible endpoint (OpenRouter, Groq, Ollama, ...)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Model / Azure deployment name (default: gpt-5.6-luna)
OPENAI_MODEL=gpt-5.6-luna

# ── AI spend guardrails ───────────────────────────────────────────
# Per-request timeout in seconds (default: 30) and SDK retry count for
# transient errors such as 429/5xx (default: 2).
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

# Total tokens this process may spend before falling back to mock output.
# 0 (default) means unlimited.
AI_TOKEN_BUDGET=0
# Tokens a single session may spend before *that session* falls back to mock output.
# 0 (default) means unlimited.
AI_SESSION_TOKEN_BUDGET=0
# Circuit breaker: after this many consecutive provider errors (default: 3) AI calls
# are skipped for the cool-off window (default: 120s), then tried again.
AI_BREAKER_FAILURES=3
AI_BREAKER_COOLDOWN_SECONDS=120

# ── Hint gating ───────────────────────────────────────────────────
# Minimum seconds between two hints for the same student (default: 60).
HINT_COOLDOWN_SECONDS=60
