# Port for the EduPulse server (default: 8000)
PORT=8000

# Comma-separated browser origins allowed to open a Socket.IO connection.
# Set this to the public URL of the deployed app (default: http://localhost:8000).
ALLOWED_ORIGINS=http://localhost:8000

# ── AI provider ───────────────────────────────────────────────────
# Azure OpenAI: set AZURE_OPENAI_API_KEY + AZURE_OPENAI_ENDPOINT,
# and set OPENAI_MODEL to your Azure *deployment* name.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# OpenAI (used when AZURE_OPENAI_ENDPOINT is empty)
OPENAI_API_KEY=

# Optional: OpenAI-compatible endpoint (OpenRouter, Groq, Ollama, ...)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Model / Azure deployment name (default: gpt-5.6-luna)
OPENAI_MODEL=gpt-5.6-luna
